generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth credentials Baileys (satu baris, id selalu 1) ───────────────────────
model AuthCreds {
  id        Int      @id @default(1)
  data      String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("auth_creds")
}

// ── Signal keys Baileys (key-value dinamis) ──────────────────────────────────
// id = "{type}__{keyId}"
model SignalKey {
  id        String   @id
  data      String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("signal_keys")
}

// ── Distributed worker lock ───────────────────────────────────────────────────
// Hanya satu baris ACTIVE yang boleh ada pada satu waktu.
// status: ACTIVE | RELEASED | EXPIRED
model WorkerLock {
  id          Int      @id @default(autoincrement())
  workerId    String   @map("worker_id")
  status      String   @default("ACTIVE")   // ACTIVE | RELEASED | EXPIRED
  heartbeatAt DateTime @map("heartbeat_at")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("worker_lock")
}

// ── Connection event log ──────────────────────────────────────────────────────
// Mencatat setiap perubahan lifecycle koneksi untuk monitoring churn.
model ConnectionEvent {
  id               Int      @id @default(autoincrement())
  workerId         String   @map("worker_id")
  event            String   // FUNCTION_START | LOCK_ACQUIRED | BAILEYS_CONNECTING |
                            // BAILEYS_CONNECTED | MESSAGE_RECEIVED | MESSAGE_SENT |
                            // DEADLINE_WARNING | GRACEFUL_DISCONNECT | LOCK_RELEASED |
                            // RECONNECT | ERROR
  disconnectReason String?  @map("disconnect_reason")
  metadata         String?  @db.Text   // JSON string untuk data tambahan
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("connection_events")
}
