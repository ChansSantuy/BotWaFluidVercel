generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuthCreds {
  id        Int      @id @default(1)
  data      String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("auth_creds")
}

model SignalKey {
  id        String   @id
  data      String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("signal_keys")
}

model WorkerLock {
  id          Int      @id @default(autoincrement())
  workerId    String   @map("worker_id")
  status      String   @default("ACTIVE")
  heartbeatAt DateTime @map("heartbeat_at")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("worker_lock")
}

model ConnectionEvent {
  id               Int      @id @default(autoincrement())
  workerId         String   @map("worker_id")
  event            String
  disconnectReason String?  @map("disconnect_reason")
  metadata         String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("connection_events")
}
